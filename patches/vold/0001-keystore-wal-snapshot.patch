+	// Recovery must preserve committed SQLite pages that still live in the WAL.
+	// Work only on copies in /tmp; never checkpoint or modify the stock database.
+	static bool copyKeystoreFile(const std::string& source, const std::string& target) {
+		struct stat file_stat;
+		if (stat(source.c_str(), &file_stat) != 0 || !S_ISREG(file_stat.st_mode)) return false;
+		std::ifstream input(source, std::ios::binary);
+		if (!input.is_open()) return false;
+		std::ofstream output(target, std::ios::binary | std::ios::trunc);
+		if (!output.is_open()) return false;
+		char buffer[16384];
+		while (input.read(buffer, sizeof(buffer)) || input.gcount() > 0) {
+			output.write(buffer, input.gcount());
+		}
+		const bool read_ok = input.eof() && !input.bad();
+		output.close();
+		return read_ok && !output.fail() && chmod(target.c_str(), 0600) == 0;
+	}
+
+	static bool snapshotKeystoreDb(const std::string& source, const std::string& target) {
+		// mkdtemp creates a private directory alongside the final destination.
+		std::string pattern = target + ".snapshot.XXXXXX";
+		std::vector<char> name(pattern.begin(), pattern.end());
+		name.push_back('\0');
+		if (!mkdtemp(name.data())) return false;
+		const std::string stage(name.data());
+		auto discard_stage = [&]() {
+			unlink((stage + "/persistent.sqlite-wal").c_str());
+			unlink((stage + "/persistent.sqlite").c_str());
+			rmdir(stage.c_str());
+		};
+		if (!copyKeystoreFile(source + "/persistent.sqlite", stage + "/persistent.sqlite")) {
+			discard_stage();
+			return false;
+		}
+		struct stat wal_stat;
+		const std::string wal = source + "/persistent.sqlite-wal";
+		if (stat(wal.c_str(), &wal_stat) == 0) {
+			if (!copyKeystoreFile(wal, stage + "/persistent.sqlite-wal")) {
+				discard_stage();
+				return false;
+			}
+		} else if (errno != ENOENT) {
+			discard_stage();
+			return false;
+		}
+		// Do not copy -shm: SQLite rebuilds its WAL index from the copied WAL.
+		// The source has no writer in recovery, and keystore2 is stopped below.
+		const std::string previous = stage + ".previous";
+		bool had_previous = false;
+		if (rename(target.c_str(), previous.c_str()) == 0) {
+			had_previous = true;
+		} else if (errno != ENOENT) {
+			discard_stage();
+			return false;
+		}
+		if (rename(stage.c_str(), target.c_str()) != 0) {
+			if (had_previous && rename(previous.c_str(), target.c_str()) != 0) {
+				printf("Failed to restore temporary keystore directory: %s\n", previous.c_str());
+			}
+			discard_stage();
+			return false;
+		}
+		// Retain the old temporary directory for diagnostics until reboot.
+		return true;
+	}
