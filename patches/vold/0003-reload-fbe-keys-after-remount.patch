+bool fscrypt_reload_keys_after_remount() {
+    // A filesystem keyring is destroyed on the last unmount. The session
+    // provisioning keyring survives, including already-unlocked CE keys.
+    // Never generate keys or change user decrypt state during a remount.
+    if (!android::vold::isFsKeyringSupported() || s_systemwide_policies.empty())
+        return true;
+    LOG(INFO) << "Reloading FBE keys after userdata remount";
+    for (const auto& policy : s_systemwide_policies) {
+        if (!android::vold::reloadKeyFromSessionKeyring(DATA_MNT_POINT, policy))
+            return false;
+    }
+    for (const auto& it : s_de_policies) {
+        if (!android::vold::reloadKeyFromSessionKeyring(DATA_MNT_POINT, it.second))
+            return false;
+    }
+    return try_reload_ce_keys();
 }
 
