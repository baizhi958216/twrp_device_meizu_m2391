From: m2391 maintainers
Subject: [PATCH] apex: Validate payload size before closing its file descriptor

loadApexImage() calls lseek() after close(fd), turning EBADF's -1 into
UINT64_MAX in lo_sizelimit. Kernels with loop size overflow checks reject
LOOP_SET_STATUS64 with EOVERFLOW. Obtain and validate the size with fstat()
before attaching the file, and detach the loop on configuration failure.

Use the loop number returned by LOOP_CTL_GET_FREE instead of a local
counter and release the loop-control descriptor on every exit path.

--- a/twrpApex.cpp
+++ b/twrpApex.cpp
@@ -97,15 +97,20 @@
 		return false;
 	}
 
-	size_t device_no = 0;
 	for (auto&& apexFile:apexFiles) {
 		int num = ioctl(fd, LOOP_CTL_GET_FREE);
+		if (num < 0) {
+			LOGERR("Unable to allocate apex loop device: %s\n", strerror(errno));
+			close(fd);
+			return false;
+		}
 		std::string loop_device = LOOP_BLOCK_DEVICE_DIR;
 		loop_device = loop_device + "loop" + std::to_string(num);
 		if (!TWFunc::Path_Exists(loop_device)) {
-			int ret = mknod(loop_device.c_str(), S_IFBLK | S_IRUSR | S_IWUSR , makedev(7, device_no));
+			int ret = mknod(loop_device.c_str(), S_IFBLK | S_IRUSR | S_IWUSR , makedev(7, num));
 			if (ret != 0) {
 				LOGERR("Unable to create loop device: %s\n", loop_device.c_str());
+				close(fd);
 				return false;
 			}
 		}
@@ -114,12 +119,13 @@
 			LOGINFO("Skipping non-existent apex file: %s\n", apexFile.c_str());
 			continue;
 		}
-		bool load_result = loadApexImage(fileToMount, device_no);
+		bool load_result = loadApexImage(fileToMount, num);
 		if (!load_result) {
+			close(fd);
 			return false;
 		}
-		device_no++;
-	}
+	}
+	close(fd);
 	return true;
 }
 
@@ -129,6 +135,18 @@
 	int fd = open(fileToMount.c_str(), O_RDONLY | O_CLOEXEC);
 	if (fd < 0) {
 		LOGERR("unable to open apex file: %s. Reason: %s\n", fileToMount.c_str(), strerror(errno));
+		return false;
+	}
+
+	struct stat st;
+	if (fstat(fd, &st) < 0) {
+		LOGERR("Unable to stat apex payload %s: %s\n", fileToMount.c_str(), strerror(errno));
+		close(fd);
+		return false;
+	}
+	if (!S_ISREG(st.st_mode) || st.st_size <= 0) {
+		LOGERR("Invalid apex payload size or file type: %s\n", fileToMount.c_str());
+		close(fd);
 		return false;
 	}
 
@@ -152,15 +170,17 @@
 
 	memset(&info, 0, sizeof(struct loop_info64));
 	strlcpy((char*)info.lo_crypt_name, "twrpApex", LO_NAME_SIZE);
-	off_t apex_size = lseek(fd, 0, SEEK_END);
-	info.lo_sizelimit = apex_size;
+	info.lo_sizelimit = st.st_size;
 	if (ioctl(loop_fd, LOOP_SET_STATUS64, &info)) {
 		LOGERR("failed to mount loop: %s: %s\n", fileToMount.c_str(), strerror(errno));
+		ioctl(loop_fd, LOOP_CLR_FD, 0);
 		close(loop_fd);
 		return false;
 	}
 	if (ioctl(loop_fd, BLKFLSBUF, 0) == -1) {
 		LOGERR("Unable to flush loop device buffers\n");
+		ioctl(loop_fd, LOOP_CLR_FD, 0);
+		close(loop_fd);
 		return false;
 	}
 	if (ioctl(loop_fd, LOOP_SET_BLOCK_SIZE, 4096) == -1) {
