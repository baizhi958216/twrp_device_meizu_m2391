+static bool IsExactMountPoint(const string& path) {
+	FILE* mounts = setmntent("/proc/mounts", "r");
+	if (!mounts) return false;
+	bool found = false;
+	struct mntent* entry;
+	while ((entry = getmntent(mounts)) != NULL) {
+		if (path == entry->mnt_dir) { found = true; break; }
+	}
+	endmntent(mounts);
+	return found;
+}
