+static std::mutex minadbd_mutex;
+static pid_t child = 0;
 
 pid_t GetMiniAdbdPid() {
+  std::lock_guard<std::mutex> lock(minadbd_mutex);
   return child;
 }
 
+void CancelMiniAdbd() {
+  // Cancellation never touches FUSE or reaps the child on the GUI thread.
+  // The sideload owner handles cleanup and USB restoration exactly once.
+  std::lock_guard<std::mutex> lock(minadbd_mutex);
+  if (child > 0) kill(child, SIGTERM);
+}
+
+static bool StopAndReapMinadbd(pid_t pid, int* status) {
+  {
+    std::lock_guard<std::mutex> lock(minadbd_mutex);
+    child = 0;
+    kill(pid, SIGTERM);
+  }
+  // Do not leave the action thread blocked in waitpid if a daemon misbehaves.
+  for (int attempt = 0; attempt < 40; ++attempt) {
+    const pid_t waited = TEMP_FAILURE_RETRY(waitpid(pid, status, WNOHANG));
+    if (waited == pid) return true;
+    if (waited == -1) {
+      PLOG(ERROR) << "Failed to reap minadbd";
+      return false;
+    }
+    if (attempt == 19) kill(pid, SIGKILL);
+    usleep(50000);
+  }
+  LOG(ERROR) << "Timed out reaping minadbd";
+  return false;
+}
+
 static bool SetUsbConfig(const std::string& state) {
-  android::base::SetProperty("sys.usb.config", state);
-  return android::base::WaitForProperty("sys.usb.state", state);
+  if (!android::base::SetProperty("sys.usb.config", state)) return false;
+  if (!android::base::WaitForProperty("sys.usb.state", state, std::chrono::seconds(10))) {
+    LOG(ERROR) << "USB transition timed out: requested=" << state
+               << ", actual=" << android::base::GetProperty("sys.usb.state", "none");
+    return false;
+  }
+  return true;
 }
 
